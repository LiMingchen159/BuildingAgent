        <mxCell id="pipeline-main-ingress" value="&lt;b&gt;BMS 来源、发现与读取&lt;br&gt;BMS source, discovery, reads&lt;/b&gt;&lt;br&gt;本地与 collector 路径并存&lt;br&gt;&lt;font color=&quot;#7a5b00&quot;&gt;部分实现 / Partial&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
