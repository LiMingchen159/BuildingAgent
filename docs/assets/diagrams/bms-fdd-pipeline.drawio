        <mxCell id="pipeline-external-note" value="连接凭据与真实客户数据不进入仓库&lt;br&gt;Credentials and customer data stay outside the repository" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#245b8a;" vertex="1" parent="1">
