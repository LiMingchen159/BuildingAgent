        </mxCell>
        <mxCell id="pipeline-main-semantic" value="&lt;b&gt;项目语义与知识材料&lt;br&gt;Project semantics and knowledge&lt;/b&gt;&lt;br&gt;TTL 可索引；无 FDD 点位部署链路&lt;br&gt;TTL indexable; no FDD deployment path&lt;br&gt;&lt;font color=&quot;#7a5b00&quot;&gt;部分实现 / Partial&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="250" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="pipeline-main-gap" value="&lt;b&gt;FDD producer / deployability / runtime&lt;/b&gt;&lt;br&gt;main 中不存在目录、求值器或服务端路由&lt;br&gt;No catalog, evaluator, or server routes on main&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;规划中 / Planned&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
