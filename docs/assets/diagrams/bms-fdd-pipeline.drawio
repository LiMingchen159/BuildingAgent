        <mxCell id="pipeline-deployability" value="&lt;b&gt;可部署性与同构设备守卫&lt;br&gt;Deployability and homogeneous-fleet guard&lt;/b&gt;&lt;br&gt;can_deploy / uncertain / cannot_deploy&lt;br&gt;v2 @71c2cb6d → v3 @6c7936e0&lt;br&gt;→ v4 homogeneous fleet @bef810af&lt;br&gt;&lt;font color=&quot;#6a3d75&quot;&gt;候选实现 / Candidate (unmerged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="945" y="545" width="240" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="pipeline-task" value="&lt;b&gt;FDD Task + evaluator&lt;/b&gt;&lt;br&gt;checking → ready | cannot_deploy&lt;br&gt;ready → running · registry-backed only&lt;br&gt;Task paused: type-only; materialization pause separate&lt;br&gt;&lt;font color=&quot;#6a3d75&quot;&gt;候选实现 / Candidate (unmerged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1225" y="545" width="220" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="pipeline-materialize" value="&lt;b&gt;物化、历史与归因&lt;br&gt;Materialization, history, attribution&lt;/b&gt;&lt;br&gt;Derived Metric records + Dashboard binding&lt;br&gt;Report adapter: planned&lt;br&gt;&lt;font color=&quot;#6a3d75&quot;&gt;候选实现 / Candidate (unmerged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1485" y="545" width="220" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="pipeline-gate" value="&lt;b&gt;项目 checks、mappings、tasks 与 results 记录 project scope、选定来源证据和失败字段；全局目录只保存规则规格。&lt;br&gt;Project checks, mappings, tasks, and results record project scope, selected provenance, and failure fields; the global catalog stores specifications only.&lt;/b&gt;&lt;br&gt;这不等同完整审计日志。198 / 59 / 111 仅描述 candidate@71c2cb6d 的 seed 快照；只有 registry-backed 规则可执行。&lt;br&gt;This is not a complete audit log. 198 / 59 / 111 describes only the candidate@71c2cb6d seed snapshot; only registry-backed rules are executable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="555" y="735" width="1020" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="pipeline-legend" value="&lt;b&gt;状态 / Status&lt;/b&gt;　&lt;font color=&quot;#2d6a2d&quot;&gt;已实现 / Implemented&lt;/font&gt;　&lt;font color=&quot;#7a5b00&quot;&gt;部分实现 / Partial&lt;/font&gt;　&lt;font color=&quot;#555555&quot;&gt;规划中 / Planned&lt;/font&gt;　&lt;font color=&quot;#245b8a&quot;&gt;外部能力 / External&lt;/font&gt;　&lt;font color=&quot;#6a3d75&quot;&gt;未合并候选 / Candidate (unmerged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=13;align=center;" vertex="1" parent="1">
