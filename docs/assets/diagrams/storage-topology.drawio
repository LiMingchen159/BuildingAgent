<mxfile host="Electron" version="31.1.8">
  <diagram id="storage-topology" name="Storage Topology">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="storage-title" value="&lt;b&gt;存储拓扑 / Storage Topology&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;两个本地数据根具有不同解析和恢复语义 / Two local roots with different resolution and recovery semantics&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="storage-api" value="&lt;b&gt;Fastify API&lt;/b&gt;&lt;br&gt;buildServer + domain stores&lt;br&gt;&lt;font color=&quot;#2d6a2d&quot;&gt;已实现 / Implemented&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="620" y="105" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="storage-store-bg" value="&lt;b&gt;数据根 A / Data Root A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;固定解析 / Fixed resolver: apps/data&lt;/font&gt;" style="swimlane;html=1;rounded=1;startSize=58;horizontal=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="650" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="storage-store-json" value="&lt;b&gt;store.json&lt;/b&gt;&lt;br&gt;用户、token、项目、成员关系&lt;br&gt;消息、会话、Dashboard、项目绑定&lt;br&gt;Users, projects, chat, dashboards, bindings&lt;br&gt;&lt;font color=&quot;#7a3e00&quot;&gt;权威业务状态 / Authoritative business state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="125" y="375" width="540" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="storage-store-temp" value="&lt;b&gt;store.json.tmp&lt;/b&gt;&lt;br&gt;原子替换的临时写入&lt;br&gt;Temporary write for rename&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;短生命周期 / Ephemeral&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="125" y="555" width="235" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="storage-store-backup" value="&lt;b&gt;store.json.bak&lt;/b&gt;&lt;br&gt;上一次本地副本&lt;br&gt;One previous local copy&lt;br&gt;&lt;font color=&quot;#8a5a00&quot;&gt;不是备份策略 / Not a backup strategy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="555" width="235" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="storage-store-note" value="约 500 ms debounce · best-effort save · 单进程语义&lt;br&gt;~500 ms debounce · best-effort save · single-process semantics" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6b4f00;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="530" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="storage-project-bg" value="&lt;b&gt;数据根 B / Data Root B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;BUILDING_AGENT_DATA_DIR 或根 data/** / configured or repository-root data/**&lt;/font&gt;" style="swimlane;html=1;rounded=1;startSize=58;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="270" width="740" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="storage-project-files" value="&lt;b&gt;项目文件 / Project files&lt;/b&gt;&lt;br&gt;&amp;lt;project&amp;gt;/kb · repository · outputs&lt;br&gt;来源材料与用户交付物&lt;br&gt;Source material and user deliverables&lt;br&gt;&lt;font color=&quot;#7a3e00&quot;&gt;权威 / Authoritative&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="835" y="375" width="205" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="storage-runtime-state" value="&lt;b&gt;定义与运行状态&lt;br&gt;Definitions and runtime state&lt;/b&gt;&lt;br&gt;derived_metrics.db&lt;br&gt;scheduled_jobs.json · Memory Markdown&lt;br&gt;&lt;font color=&quot;#7a3e00&quot;&gt;按域备份 / Back up by domain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1070" y="375" width="205" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="storage-indexes" value="&lt;b&gt;可重建索引&lt;br&gt;Rebuildable indexes&lt;/b&gt;&lt;br&gt;session_index.db&lt;br&gt;grounding_index.db&lt;br&gt;&lt;font color=&quot;#2d6a2d&quot;&gt;由 store 重建 / Rebuilt from store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1305" y="375" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="storage-diagnostics" value="&lt;b&gt;诊断与临时数据&lt;br&gt;Diagnostics and transient data&lt;/b&gt;&lt;br&gt;tool_call_logs.json · structured logs&lt;br&gt;temporary uploads&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;保留 + 脱敏 / Retain + redact&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="835" y="565" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="storage-fixtures" value="&lt;b&gt;仓库公开 fixture / Public repository fixtures&lt;/b&gt;&lt;br&gt;data/project_element · data/project_mortar&lt;br&gt;不得替换为真实客户数据 / Never replace with real customer data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1185" y="565" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="storage-external-bg" value="&lt;b&gt;外部权威数据 / External authoritative data&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="825" width="760" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="storage-external-bms" value="&lt;b&gt;BMS / Collector&lt;/b&gt;&lt;br&gt;真实点位与时序 / Real points and series&lt;br&gt;&lt;font color=&quot;#245b8a&quot;&gt;外部能力 / External&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="485" y="875" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="storage-external-llm" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;推理服务，不保存本地业务权威事实&lt;br&gt;Inference, not local fact authority&lt;br&gt;&lt;font color=&quot;#245b8a&quot;&gt;外部能力 / External&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="835" y="875" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="storage-edge-store" value="load + debounced save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=block;strokeColor=#d6b656;fontSize=12;" edge="1" parent="1" source="storage-api" target="storage-store-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="storage-edge-project" value="domain stores + files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=block;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="storage-api" target="storage-project-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="storage-edge-rebuild-session" value="启动重建 / startup rebuild" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="storage-store-json" target="storage-indexes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="740" y="520"/><mxPoint x="740" y="345"/><mxPoint x="1395" y="345"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="storage-edge-external" value="按需读取 / Read on demand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=block;strokeColor=#3b82f6;fontSize=11;" edge="1" parent="1" source="storage-api" target="storage-external-bg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1545" y="150"/><mxPoint x="1545" y="800"/><mxPoint x="800" y="800"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="storage-warning" value="&lt;b&gt;关键边界 / Critical boundary&lt;/b&gt;：配置 BUILDING_AGENT_DATA_DIR 不会移动 apps/data/store.json；两个数据根没有统一事务或备份。&lt;br&gt;Configuring BUILDING_AGENT_DATA_DIR does not move apps/data/store.json; the roots have no shared transaction or backup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="215" width="980" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
